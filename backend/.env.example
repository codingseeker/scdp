# Copy this file to `.env` in the backend/ directory and fill in real values.
# Development works without most secrets: leave API keys empty and the app
# falls back to bundled demo data. NEVER commit a real `.env`.

# Application
APP_ENV=development
LOG_LEVEL=INFO
DEBUG=false

# Server
HOST=0.0.0.0
PORT=8000
WORKERS=1

# Neo4j (leave password empty to run in demo-data mode)
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
NEO4J_MAX_CONNECTION_POOL_SIZE=50
NEO4J_CONNECTION_TIMEOUT=30

# Redis (optional caching layer — leave REDIS_URL empty to disable)
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=
REDIS_SSL=false
REDIS_CACHE_TTL=300

# Gemini AI (optional — leave empty to skip AI enrichment)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-pro
GEMINI_MAX_TOKENS=4096
GEMINI_TIMEOUT=30
GEMINI_RATE_LIMIT_RPM=60

# External intelligence (optional — leave empty to skip)
NEWS_API_KEY=
NEWS_API_TIMEOUT=15
WEATHER_API_KEY=
WEATHER_API_TIMEOUT=15

# Authentication
# In-memory demo users are created only for the roles you provide here.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_admin
ANALYST_USERNAME=analyst
ANALYST_PASSWORD=change_me_analyst
VIEWER_USERNAME=viewer
VIEWER_PASSWORD=change_me_viewer
# Strong, unique secret (32+ chars). Required and validated in production.
JWT_SECRET=change_me_jwt_secret_min_32_chars_long
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
CORS_ORIGINS=http://localhost:5173

# Rate Limiting
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_AUTH=20/minute
RATE_LIMIT_SIMULATION=10/minute
RATE_LIMIT_AI=30/minute

# Request Limits
MAX_REQUEST_BODY_SIZE=1048576
MAX_PAGINATION_LIMIT=100
